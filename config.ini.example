[Cloudflare]
api_url = https://healthcheckwatch.your-subdomain.workers.dev
api_token = YOUR_SECRET_TOKEN
# Or keep the token out of this file: path to a file holding it (overrides api_token)
# api_token_file = /path/to/healthcheckwatch.apitoken

# --- Optional: account credentials for manage.py (wrangler) only ---
# Real D1 database UUID (from `wrangler d1 list`). Set this so wrangler.jsonc can
# keep its "xxxx-xxxx-xxxx-xxxx" placeholder and never leak the id to a public repo.
# database_id = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to a file holding your Cloudflare ACCOUNT API token (for wrangler auth).
# If CLOUDFLARE_API_TOKEN is already exported in your shell, that wins over this.
# cf_token_file = /path/to/cloudflare.apitoken

[Settings]
# Set to 'yes' to NOT send emails (e.g., during planned downtime) but continue logging
squelch = no

# Can be 'local' or 'UTC'
timezone = local

[SMTP]
host = mail.host.net
port = 465
user = user@domain.net
pass = your_password
# Set to 'yes' for port 465 (Implicit SSL), 'no' for port 587 (STARTTLS)
use_ssl = yes
# Set to 'no' to send through a local relay (e.g. postfix: host = localhost,
# port = 25) with no TLS or login; pass and use_ssl are then ignored
auth = yes
